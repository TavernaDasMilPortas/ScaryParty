/* Base Container */
.lobby-container {
    flex-grow: 1;
    background-color: rgb(13, 13, 13);
    align-items: center;
    justify-content: center;
    padding: 20px;
    width: 100%;
    height: 100%;
}

.header-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 140, 0);
    margin-bottom: 30px;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

.main-content {
    flex-direction: row;
    width: 90%;
    height: 80%;
    justify-content: space-around;
}

/* Panels (Glassmorphism effect) */
.panel {
    background-color: rgba(30, 30, 30, 0.6);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    flex-grow: 1;
    margin: 0 10px;
}

.column-left {
    flex-basis: 25%;
}

.column-center {
    flex-basis: 40%;
}

.column-right {
    flex-basis: 30%;
}

.panel-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(224, 224, 224);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding-bottom: 10px;
}

/* Typography & Inputs */
.field-label {
    font-size: 16px;
    color: rgb(180, 180, 180);
    margin-top: 10px;
    margin-bottom: 5px;
}

.input-field {
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    font-size: 18px;
    padding: 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 140, 0, 0.5);
    margin-bottom: 15px;
}

/* Força texto branco e legível dentro de TextFields */
.input-field .unity-text-field__input,
.input-field .unity-base-text-field__input {
    color: white;
    font-size: 18px;
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

/* Placeholder text (quando vazio) — cinza claro */
.input-field .unity-text-field__placeholder .unity-text-element {
    color: rgba(180, 180, 180, 0.6);
    font-size: 16px;
}

/* Color Picker */
.color-preview {
    width: 100%;
    height: 60px;
    border-radius: 10px;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: white;
}

.color-palette {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
}

.color-btn {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    cursor: pointer;
}

.color-btn:hover {
    border-color: white;
}

.color-orange { background-color: rgb(255, 102, 0); }
.color-green { background-color: rgb(51, 204, 51); }
.color-blue { background-color: rgb(51, 102, 255); }
.color-purple { background-color: rgb(204, 51, 204); }

/* Buttons */
.action-btn {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(80, 80, 80, 0.8);
    padding: 12px;
    border-radius: 8px;
    border-width: 2px;
    border-color: transparent;
    cursor: pointer;
    transition-duration: 0.2s;
    margin-top: auto;
}

.action-btn:hover {
    background-color: rgba(100, 100, 100, 0.9);
    border-color: white;
}

.create-btn {
    background-color: rgba(255, 140, 0, 0.8);
}
.create-btn:hover {
    background-color: rgb(255, 140, 0);
}

.join-manual-btn {
    background-color: rgba(51, 153, 255, 0.8);
}
.join-manual-btn:hover {
    background-color: rgb(51, 153, 255);
}

/* Room List */
.room-list {
    flex-grow: 1;
    margin-bottom: 15px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    padding: 10px;
}

.no-rooms-label {
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    margin-top: 20px;
    font-size: 16px;
}

.room-entry {
    flex-direction: row;
    background-color: rgba(50, 50, 50, 0.6);
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 8px;
    border-left-width: 4px;
    border-left-color: rgb(51, 204, 51);
    align-items: center;
    justify-content: space-between;
}

.room-entry:hover {
    background-color: rgba(70, 70, 70, 0.8);
}

.room-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
}

.room-details {
    font-size: 12px;
    color: rgb(180, 180, 180);
}

.join-btn {
    background-color: rgb(51, 204, 51);
    color: white;
    -unity-font-style: bold;
    border-radius: 5px;
    padding: 5px 15px;
    cursor: pointer;
}
.join-btn:hover {
    background-color: rgb(102, 255, 102);
}

/* Divider */
.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin: 20px 0;
}
