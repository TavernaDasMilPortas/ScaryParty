/* Base Container */
.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 20px;
}

/* Typography Base */
.unity-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

/* Top Section */
.top-section {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* Stats (Top Left) */
.stats-container {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 10px;
    padding: 15px;
    border-width: 2px;
    border-color: rgb(255, 140, 0);
}

.money-label {
    font-size: 36px;
    color: rgb(133, 224, 100);
}

.score-label {
    font-size: 24px;
    color: rgb(220, 220, 220);
}

/* Minimap (Bottom Right) */
.minimap-container {
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 10px;
    padding: 10px;
    width: 250px;
    height: 250px;
    border-width: 3px;
    border-color: rgb(100, 200, 255);
    align-items: center;
    position: absolute;
    bottom: 20px;
    right: 20px;
}

.minimap-image {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border-radius: 5px;
    margin-bottom: 5px;
    background-color: rgb(30, 30, 30);
}

.minimap-title {
    font-size: 16px;
    color: rgb(100, 200, 255);
    -unity-text-align: middle-center;
}

/* Orders (Top Right) */
.orders-container {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 10px;
    padding: 15px;
    width: 300px;
    max-height: 400px;
    border-width: 2px;
    border-color: rgb(255, 140, 0);
}

.orders-title {
    font-size: 24px;
    color: rgb(255, 200, 50);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.orders-list {
    flex-grow: 1;
}

.order-item {
    background-color: rgba(50, 50, 50, 0.8);
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 100, 50);
}

.order-item-text {
    font-size: 16px;
    white-space: normal;
}

/* Center Section */
.center-section {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.interaction-prompt {
    font-size: 28px;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 15px 30px;
    border-radius: 30px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.2s;
}

.hidden {
    opacity: 0;
    display: none;
}

/* Bottom Section */
.bottom-section {
    align-items: center;
    margin-bottom: 20px;
}

.hands-container {
    flex-direction: row;
    justify-content: space-between;
    width: 400px;
}

.hand-slot {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 15px;
    padding: 15px;
    width: 180px;
    height: 100px;
    border-width: 3px;
    border-color: rgb(150, 150, 150);
    align-items: center;
    justify-content: center;
}

.hand-slot:hover {
    border-color: rgb(255, 255, 255);
    background-color: rgba(40, 40, 40, 0.8);
}

.hand-title {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 5px;
}

.hand-content {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

/* ========================================
   SCOREBOARD (Tab Overlay)
   ======================================== */

.scoreboard-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.scoreboard-panel {
    background-color: rgba(15, 15, 15, 0.95);
    border-radius: 15px;
    padding: 20px 25px;
    width: 620px;
    max-height: 500px;
    border-width: 2px;
    border-color: rgb(255, 140, 0);
}

.scoreboard-title {
    font-size: 28px;
    color: rgb(255, 200, 50);
    -unity-text-align: middle-center;
    margin-bottom: 15px;
    letter-spacing: 4px;
}

.scoreboard-header {
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.3);
    padding-bottom: 8px;
    margin-bottom: 5px;
}

.scoreboard-row {
    flex-direction: row;
    padding: 6px 10px;
    align-items: center;
}

.scoreboard-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 5px;
}

.scoreboard-list {
    flex-grow: 1;
    max-height: 350px;
}

.scoreboard-cell {
    font-size: 18px;
}

.scoreboard-name {
    width: 40%;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.scoreboard-slots {
    width: 30%;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(255, 200, 100);
    letter-spacing: 3px;
}

.scoreboard-money {
    width: 30%;
    -unity-text-align: middle-right;
    color: rgb(133, 224, 100);
    font-size: 20px;
}
