<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Piaria/USS/PiariaCommon.uss" />
    <Style src="project://database/Assets/UI/Piaria/USS/MainMenu.uss" />
    
    <ui:VisualElement name="MainMenuRoot" class="fullscreen-root main-menu-bg">
        <!-- Decorações de Fita Quadriculada -->
        <ui:VisualElement name="CheckeredTopLeft" class="checkered-deco deco-left" />
        <ui:VisualElement name="CheckeredTopRight" class="checkered-deco deco-right" />

        <!-- Centro: Marca, Subtítulo e Menu -->
        <ui:VisualElement class="menu-center-container">
            <!-- Logotipo P.I.A.R.I.A -->
            <ui:VisualElement name="LogoPiaria" class="logo-piaria" />
            <ui:VisualElement name="LogoSubtitle" class="logo-subtitle" />

            <!-- Faixas de Navegação -->
            <ui:VisualElement class="menu-buttons-group">
                <ui:Button name="BtnPlay" class="ribbon-btn btn-play">
                    <ui:VisualElement name="ArtPlay" class="btn-text-art art-play" />
                    <ui:Label text="JOGAR" class="btn-fallback-text" />
                </ui:Button>

                <ui:Button name="BtnSettings" class="ribbon-btn btn-settings">
                    <ui:VisualElement name="ArtSettings" class="btn-text-art art-settings" />
                    <ui:Label text="CONFIGURAÇÕES" class="btn-fallback-text" />
                </ui:Button>

                <ui:Button name="BtnQuit" class="ribbon-btn btn-quit">
                    <ui:VisualElement name="ArtQuit" class="btn-text-art art-quit" />
                    <ui:Label text="SAIR" class="btn-fallback-text" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Rodapé -->
        <ui:VisualElement class="menu-footer">
            <ui:Label text="v1.0.0 — P.I.A.R.I.A Prototype" class="footer-text footer-left" />
            <ui:Label text="Taverna das Mil Portas" class="footer-text footer-right" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
