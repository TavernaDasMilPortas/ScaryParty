<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Piaria/USS/PiariaCommon.uss" />
    <Style src="project://database/Assets/UI/Piaria/USS/HUD.uss" />
    
    <ui:VisualElement name="MainGameHUDRoot" class="fullscreen-root hud-pass-through">
        <!-- Topo Esquerdo: Estatísticas (Dinheiro e Entregas) -->
        <ui:VisualElement class="hud-top-left">
            <ui:VisualElement class="stat-badge money-badge">
                <ui:VisualElement name="IconMoney" class="badge-icon icon-money" />
                <ui:Label name="MoneyLabel" text="R$0" class="badge-text" />
            </ui:VisualElement>

            <ui:VisualElement class="stat-badge deliveries-badge">
                <ui:VisualElement name="IconDeliveries" class="badge-icon icon-deliveries" />
                <ui:Label name="ScoreLabel" text="Entregas: 0" class="badge-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Topo Centro: Banner de Comandas Ativas -->
        <ui:VisualElement class="hud-top-center">
            <ui:VisualElement name="ActiveOrdersWidget" class="orders-hint-card">
                <ui:Label name="ActiveOrdersLabel" text="📋 COMANDAS: Nenhuma ativa" class="orders-hint-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Centro: Prompt Contextual e Barra de Progresso -->
        <ui:VisualElement class="hud-center-anchor">
            <ui:Label name="InteractionPrompt" text="[E] Interagir" class="interaction-prompt-box" />
            
            <ui:VisualElement name="ProgressBarContainer" class="progress-bar-box">
                <ui:VisualElement name="ProgressBarFrame" class="progress-frame">
                    <ui:VisualElement name="ProgressBarFill" class="progress-fill" />
                </ui:VisualElement>
                <ui:Label name="ProgressBarLabel" text="Preparando..." class="progress-text-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Rodapé Esquerdo: Atalhos Rápidos -->
        <ui:VisualElement class="hud-bottom-left">
            <ui:VisualElement class="hud-hints-bar">
                <ui:Label text="📖 [H] Receitas  •  🎒 [B] Mochila  •  Tab [Placar]" class="hints-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Rodapé Centro: Mãos (Slots 1 e 2) e Mochila -->
        <ui:VisualElement class="hud-bottom-center">
            <!-- Mochila de Pizzas (Stack) -->
            <ui:VisualElement name="BackpackContainer" class="backpack-stack-box">
                <ui:VisualElement name="BackpackGradientLayer" class="backpack-art-layer gradient-layer" />
                <ui:VisualElement name="BackpackPizzaLayer" class="backpack-art-layer pizza-layer" />
                <ui:Label name="BackpackCountLabel" text="0" class="backpack-badge-text" />
            </ui:VisualElement>

            <!-- Slots das Mãos -->
            <ui:VisualElement class="hands-row">
                <!-- Mão Esquerda -->
                <ui:VisualElement name="LeftHandSlot" class="hand-card hand-slot-left">
                    <ui:VisualElement class="hand-card-header">
                        <ui:VisualElement name="Digit1Icon" class="hand-digit-art digit-1" />
                        <ui:Label text="Mão Esquerda" class="hand-slot-title" />
                    </ui:VisualElement>
                    <ui:Label name="LeftHandContent" text="Vazio" class="hand-content-label" />
                </ui:VisualElement>

                <!-- Mão Direita -->
                <ui:VisualElement name="RightHandSlot" class="hand-card hand-slot-right">
                    <ui:VisualElement class="hand-card-header">
                        <ui:VisualElement name="Digit2Icon" class="hand-digit-art digit-2" />
                        <ui:Label text="Mão Direita" class="hand-slot-title" />
                    </ui:VisualElement>
                    <ui:Label name="RightHandContent" text="Vazio" class="hand-content-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Rodapé Direito: Minimapa com moldura de papel -->
        <ui:VisualElement name="MinimapContainer" class="hud-bottom-right">
            <ui:VisualElement name="MinimapPaperFrame" class="minimap-paper-wrapper">
                <ui:VisualElement name="MinimapImage" class="minimap-render-surface" />
            </ui:VisualElement>
            <ui:Label text="[M] Mapa da Cidade" class="minimap-hint-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
