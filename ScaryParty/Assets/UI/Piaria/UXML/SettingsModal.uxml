<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Piaria/USS/PiariaCommon.uss" />
    <Style src="project://database/Assets/UI/Piaria/USS/Settings.uss" />
    
    <ui:VisualElement name="SettingsModalRoot" class="modal-backdrop">
        <ui:VisualElement name="SettingsCard" class="modal-card settings-card">
            <!-- Cabeçalho -->
            <ui:VisualElement class="settings-header">
                <ui:Label text="CONFIGURAÇÕES" class="header-title-text" />
                <ui:Button name="BtnCloseTop" text="✕" class="close-icon-btn" />
            </ui:VisualElement>

            <!-- Conteúdo em Abas ou Lista com Scroll -->
            <ui:ScrollView class="settings-scroll">
                <!-- Seção Áudio -->
                <ui:Label text="ÁUDIO" class="section-title" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Volume Geral" class="setting-label" />
                    <ui:Slider name="SliderMasterVolume" low-value="0" high-value="1" value="1" class="setting-slider" />
                    <ui:Label name="LabelMasterVal" text="100%" class="setting-val-label" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Música" class="setting-label" />
                    <ui:Slider name="SliderMusicVolume" low-value="0" high-value="1" value="0.8" class="setting-slider" />
                    <ui:Label name="LabelMusicVal" text="80%" class="setting-val-label" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Efeitos Sonoros (SFX)" class="setting-label" />
                    <ui:Slider name="SliderSfxVolume" low-value="0" high-value="1" value="1" class="setting-slider" />
                    <ui:Label name="LabelSfxVal" text="100%" class="setting-val-label" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-divider" />

                <!-- Seção Jogabilidade & Controles -->
                <ui:Label text="CONTROLES & VISÃO" class="section-title" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Sensibilidade do Olhar" class="setting-label" />
                    <ui:Slider name="SliderSensitivity" low-value="0.1" high-value="3.0" value="1.0" class="setting-slider" />
                    <ui:Label name="LabelSensVal" text="1.0" class="setting-val-label" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-divider" />

                <!-- Seção Acessibilidade & Interface -->
                <ui:Label text="INTERFACE & ACESSIBILIDADE" class="section-title" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Escala da Interface" class="setting-label" />
                    <ui:Slider name="SliderUiScale" low-value="0.8" high-value="1.4" value="1.0" class="setting-slider" />
                    <ui:Label name="LabelScaleVal" text="100%" class="setting-val-label" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Reduzir Movimento / Tremores" class="setting-label" />
                    <ui:Toggle name="ToggleReduceMotion" class="setting-toggle" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-divider" />

                <!-- Seção Vídeo -->
                <ui:Label text="VÍDEO & DESEMPENHO" class="section-title" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Qualidade Gráfica" class="setting-label" />
                    <ui:DropdownField name="DropdownQuality" class="setting-dropdown" />
                </ui:VisualElement>
            </ui:ScrollView>

            <!-- Rodapé / Ações -->
            <ui:VisualElement class="settings-actions">
                <ui:Button name="BtnResetSettings" text="Restaurar Padrões" class="piaria-button piaria-button-secondary action-btn-half" />
                <ui:Button name="BtnSaveSettings" text="Concluir" class="piaria-button piaria-button-success action-btn-half" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
