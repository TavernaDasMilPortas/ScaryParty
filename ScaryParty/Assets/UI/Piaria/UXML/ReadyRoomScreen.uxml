<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Piaria/USS/PiariaCommon.uss" />
    <Style src="project://database/Assets/UI/Piaria/USS/ReadyRoom.uss" />
    
    <ui:VisualElement name="ReadyRoomRoot" class="fullscreen-root ready-room-bg">
        <!-- Topo: Título da Sala e Banner de Código -->
        <ui:VisualElement class="ready-top-section">
            <ui:VisualElement name="TitleWaitingRoom" class="waiting-title-art" />
            
            <ui:VisualElement class="room-code-banner">
                <ui:Label name="RoomCodeLabel" text="CÓDIGO DA SALA: CARREGANDO..." class="room-code-text" />
                <ui:Button name="BtnCopyCode" text="COPIAR CÓDIGO" class="piaria-button piaria-button-secondary btn-copy-code" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Centro: 4 Cartões Horizontais dos Jogadores -->
        <ui:VisualElement name="PlayerCardsRow" class="four-cards-row">
            <!-- Slot 0 -->
            <ui:VisualElement name="SlotCard0" class="player-slot-card paper-panel">
                <ui:VisualElement name="CardOccupied0" class="card-content-occupied">
                    <ui:VisualElement name="PlayerNameBar0" class="player-name-ribbon">
                        <ui:Label name="PlayerNameLabel0" text="Jogador 1" class="player-name-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-avatar-box">
                        <ui:VisualElement name="PlayerColor0" class="avatar-color-swatch" />
                        <ui:Label name="PlayerAvatarIcon0" text="🧑‍🍳" class="avatar-fallback-icon" />
                    </ui:VisualElement>
                    <ui:Label name="PlayerRoleLabel0" text="👑 Líder da Sala" class="player-role-text" />
                    <ui:Label name="PlayerReadyBadge0" text="PREPARANDO..." class="player-status-tag status-waiting" />
                </ui:VisualElement>
                <ui:VisualElement name="CardEmpty0" class="card-content-empty" style="display: none;">
                    <ui:Label text="+" class="empty-plus-icon" />
                    <ui:Label text="VAGA LIVRE" class="empty-slot-text" />
                    <ui:Label text="Aguardando jogador..." class="empty-subtext" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Slot 1 -->
            <ui:VisualElement name="SlotCard1" class="player-slot-card paper-panel">
                <ui:VisualElement name="CardOccupied1" class="card-content-occupied">
                    <ui:VisualElement name="PlayerNameBar1" class="player-name-ribbon">
                        <ui:Label name="PlayerNameLabel1" text="Jogador 2" class="player-name-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-avatar-box">
                        <ui:VisualElement name="PlayerColor1" class="avatar-color-swatch" />
                        <ui:Label name="PlayerAvatarIcon1" text="🧑‍🍳" class="avatar-fallback-icon" />
                    </ui:VisualElement>
                    <ui:Label name="PlayerRoleLabel1" text="Cozinheiro" class="player-role-text" />
                    <ui:Label name="PlayerReadyBadge1" text="PREPARANDO..." class="player-status-tag status-waiting" />
                </ui:VisualElement>
                <ui:VisualElement name="CardEmpty1" class="card-content-empty">
                    <ui:Label text="+" class="empty-plus-icon" />
                    <ui:Label text="VAGA LIVRE" class="empty-slot-text" />
                    <ui:Label text="Aguardando jogador..." class="empty-subtext" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Slot 2 -->
            <ui:VisualElement name="SlotCard2" class="player-slot-card paper-panel">
                <ui:VisualElement name="CardOccupied2" class="card-content-occupied">
                    <ui:VisualElement name="PlayerNameBar2" class="player-name-ribbon">
                        <ui:Label name="PlayerNameLabel2" text="Jogador 3" class="player-name-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-avatar-box">
                        <ui:VisualElement name="PlayerColor2" class="avatar-color-swatch" />
                        <ui:Label name="PlayerAvatarIcon2" text="🍕" class="avatar-fallback-icon" />
                    </ui:VisualElement>
                    <ui:Label name="PlayerRoleLabel2" text="Entregador" class="player-role-text" />
                    <ui:Label name="PlayerReadyBadge2" text="PREPARANDO..." class="player-status-tag status-waiting" />
                </ui:VisualElement>
                <ui:VisualElement name="CardEmpty2" class="card-content-empty">
                    <ui:Label text="+" class="empty-plus-icon" />
                    <ui:Label text="VAGA LIVRE" class="empty-slot-text" />
                    <ui:Label text="Aguardando jogador..." class="empty-subtext" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Slot 3 -->
            <ui:VisualElement name="SlotCard3" class="player-slot-card paper-panel">
                <ui:VisualElement name="CardOccupied3" class="card-content-occupied">
                    <ui:VisualElement name="PlayerNameBar3" class="player-name-ribbon">
                        <ui:Label name="PlayerNameLabel3" text="Jogador 4" class="player-name-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-avatar-box">
                        <ui:VisualElement name="PlayerColor3" class="avatar-color-swatch" />
                        <ui:Label name="PlayerAvatarIcon3" text="🍕" class="avatar-fallback-icon" />
                    </ui:VisualElement>
                    <ui:Label name="PlayerRoleLabel3" text="Ajudante" class="player-role-text" />
                    <ui:Label name="PlayerReadyBadge3" text="PREPARANDO..." class="player-status-tag status-waiting" />
                </ui:VisualElement>
                <ui:VisualElement name="CardEmpty3" class="card-content-empty">
                    <ui:Label text="+" class="empty-plus-icon" />
                    <ui:Label text="VAGA LIVRE" class="empty-slot-text" />
                    <ui:Label text="Aguardando jogador..." class="empty-subtext" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Barra de Ações Inferior -->
        <ui:VisualElement class="ready-actions-bar">
            <ui:Button name="BtnReady" text="ESTOU PRONTO" class="piaria-button piaria-button-success btn-action-ready" />
            <ui:Button name="BtnStartGame" text="INICIAR JOGO" class="piaria-button piaria-button-primary btn-action-start" />
            <ui:Button name="BtnEditProfile" text="EDITAR PERFIL" class="piaria-button piaria-button-secondary btn-action-edit" />
            <ui:Button name="BtnLeaveRoom" text="SAIR DA SALA" class="piaria-button piaria-button-danger btn-action-leave" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
