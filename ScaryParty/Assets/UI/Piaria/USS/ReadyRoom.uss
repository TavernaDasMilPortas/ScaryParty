.ready-room-bg {
    background-color: var(--color-bg-peach);
    padding: 20px 36px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.ready-top-section {
    width: 100%;
    align-items: center;
    margin-bottom: 4px;
}

.waiting-title-art {
    width: 320px;
    height: 56px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.room-code-banner {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 10px;
    padding: 6px 18px;
}

.room-code-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    margin-right: 14px;
}

.btn-copy-code {
    font-size: 14px;
    padding: 5px 14px;
}

/* 4 Cartões Horizontais */
.four-cards-row {
    flex-grow: 1;
    width: 100%;
    max-width: 1400px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 12px;
}

.player-slot-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 9px;
    margin-right: 9px;
    max-width: 310px;
    height: 480px;
    border-radius: 16px;
    padding: 16px;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-paper-light);
    -unity-background-scale-mode: stretch-to-fill;
}

.card-content-occupied {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
}

.player-name-ribbon {
    width: 100%;
    height: 50px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: stretch-to-fill;
}

.player-name-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}

.card-avatar-box {
    width: 170px;
    height: 180px;
    background-color: var(--color-paper-dark);
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.card-preview-rt {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    -unity-background-scale-mode: scale-and-crop;
}

.avatar-color-swatch {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-border-brown);
}

.avatar-fallback-icon {
    font-size: 58px;
    -unity-text-align: middle-center;
}

.player-role-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
}

.player-status-tag {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 8px 16px;
    border-radius: 8px;
    width: 88%;
    -unity-text-align: middle-center;
}

.status-ready {
    color: #1B5E20;
    background-color: #C8E6C9;
    border-color: #2E7D32;
    border-width: 2px;
}

.status-waiting {
    color: #E65100;
    background-color: #FFE0B2;
    border-color: #EF6C00;
    border-width: 2px;
}

/* Vaga Vazia */
.card-content-empty {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    opacity: 0.55;
    border-width: 2px;
    border-color: var(--color-border-brown-light);
    border-radius: 12px;
}

.empty-plus-icon {
    font-size: 44px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
}

.empty-slot-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.empty-subtext {
    font-size: 12px;
    color: var(--color-text-muted);
}

/* Barra de Ações Inferior */
.ready-actions-bar {
    width: 100%;
    max-width: 1080px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 56px;
}

.ready-actions-bar .ribbon-btn {
    margin-left: 6px;
    margin-right: 6px;
}

.btn-action-ready {
    flex-grow: 1.3;
    height: 50px;
}

.btn-action-start {
    flex-grow: 1.3;
    height: 50px;
}

.btn-action-edit {
    flex-grow: 1;
    height: 50px;
}

.btn-action-leave {
    flex-grow: 1;
    height: 50px;
}
