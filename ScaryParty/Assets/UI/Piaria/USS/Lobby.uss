.lobby-bg {
    background-color: var(--color-bg-peach);
    padding: 20px 32px;
    flex-direction: column;
    -unity-background-scale-mode: scale-and-crop;
}

.lobby-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    margin-bottom: 12px;
}

.btn-back-lobby {
    width: 104px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.btn-back-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.lobby-title-art {
    width: 280px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.lobby-header-spacer {
    width: 104px;
}

/* Colunas Proporcionadas 1 : 1.1 : 1 */
.lobby-three-columns {
    flex-grow: 1;
    flex-direction: row;
}

.col-profile {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-right: 10px;
}

.col-roomlist {
    flex-grow: 1.1;
    flex-basis: 0;
    flex-direction: column;
    margin-left: 10px;
    margin-right: 10px;
}

.col-connect {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-left: 10px;
}

.section-header-art {
    height: 46px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.field-subheading {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
    margin-top: 6px;
    margin-bottom: 4px;
}

.color-palette-row {
    flex-direction: row;
    margin-bottom: 10px;
    justify-content: space-between;
}

.color-dot {
    width: 44px;
    height: 44px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.color-dot:hover {
    scale: 1.1;
}

.character-preview-container {
    flex-grow: 1;
    min-height: 190px;
    position: relative;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
}

.character-preview-rt {
    position: absolute;
    width: 88%;
    height: 88%;
    border-radius: 10px;
    -unity-background-scale-mode: scale-and-crop;
}

.character-preview-frame {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.btn-save-profile {
    width: 100%;
}

.room-scroll-list {
    flex-grow: 1;
    margin-bottom: 12px;
}

.empty-rooms-container {
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.no-rooms-art {
    width: 220px;
    height: 72px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.no-rooms-label {
    font-size: 15px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}

.room-entry {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #FFFDF7;
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
}

.room-name-lbl {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.room-details-lbl {
    font-size: 13px;
    color: var(--color-text-muted);
}

.connect-scroll {
    flex-grow: 1;
}

.col-divider {
    height: 2px;
    background-color: var(--color-border-brown-light);
    margin-top: 10px;
    margin-bottom: 10px;
}

.mb-10 { margin-bottom: 10px; }
.mb-14 { margin-bottom: 14px; }
