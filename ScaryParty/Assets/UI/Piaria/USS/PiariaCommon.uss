/* ========================================================
   P.I.A.R.I.A — Identidade Visual e Tokens Comuns
   Paleta: Pêssego claro #f8d5c4, creme #ffebd5, tinta #402318,
           laranja #ff741f, papel #ffdec0 e artes ilustradas
   ======================================================== */

:root {
    --color-bg-peach: #f8d5c4;
    --color-cream: #ffebd5;
    --color-ink: #402318;
    --color-orange: #ff741f;
    --color-paper: #ffdec0;
    --color-paper-light: #ffebd5;
    --color-paper-dark: #f0caa8;
    --color-border-brown: #402318;
    --color-border-brown-light: #7a4630;
    --color-text-dark: #402318;
    --color-text-muted: #7a503e;
    --color-accent-yellow: #f8c045;
    --color-btn-orange: #ff741f;
    --color-btn-green: #3ca34d;
    --color-btn-blue: #2e79b9;
    --color-btn-red: #c83232;
    --color-btn-pink: #d94578;
    
    font-size: 18px;
    color: var(--color-text-dark);
    -unity-font: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
    -unity-font-definition: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
}

.fullscreen-root, TemplateContainer {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.hud-pass-through {
    /* pickingMode definido como Ignore via UXML */
}

/* Tipografia Semântica */
.title-font {
    -unity-font: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/lost-tumbler/Lost Tumbler.otf");
    -unity-font-definition: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/lost-tumbler/Lost Tumbler.otf");
}

.body-font {
    -unity-font: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
    -unity-font-definition: url("project://database/Assets/StarterAssets/Piaaria/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
}

/* Painéis de Papel */
.paper-panel {
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 0;
    border-radius: 14px;
    padding: 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

.paper-panel-dark {
    background-color: var(--color-paper-dark);
    border-color: var(--color-border-brown);
    border-width: 0;
    border-radius: 14px;
    padding: 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Botões do Tema P.I.A.R.I.A */
.piaria-button {
    background-color: var(--color-btn-orange);
    border-color: var(--color-border-brown);
    border-width: 3px;
    border-radius: 12px;
    padding: 10px 20px;
    color: #FFFFFF;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.piaria-button-primary {
    background-color: var(--color-btn-orange);
}

.piaria-button-secondary {
    background-color: var(--color-btn-blue);
}

.piaria-button-success {
    background-color: var(--color-btn-green);
}

.piaria-button-danger {
    background-color: var(--color-btn-red);
}

.piaria-button:disabled {
    opacity: 0.5;
}

/* Campos de Texto e Inputs */
.piaria-input {
    background-color: #FFFDF8;
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 18px;
    color: var(--color-text-dark);
}

.piaria-input:focus {
    border-color: var(--color-accent-yellow);
    border-width: 3px;
}

/* Modais */
.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(40, 20, 10, 0.60);
    justify-content: center;
    align-items: center;
}

.modal-card {
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 4px;
    border-radius: 16px;
    padding: 26px;
    max-width: 820px;
}

.header-title-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}
