.main-menu-bg {
    background-color: var(--color-bg-peach);
    justify-content: center;
    align-items: center;
}

.checkered-deco {
    position: absolute;
    width: 240px;
    height: 85px;
    top: 20px;
    opacity: 0.35;
    -unity-background-scale-mode: scale-to-fit;
}

.deco-left {
    left: 20px;
    rotate: -15deg;
}

.deco-right {
    right: 20px;
    rotate: 15deg;
}

.menu-center-container {
    width: 500px;
    align-items: center;
    justify-content: center;
}

.logo-piaria {
    width: 430px;
    height: 92px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.logo-subtitle {
    width: 390px;
    height: 56px;
    margin-bottom: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

.menu-buttons-group {
    width: 320px;
    align-items: center;
    justify-content: center;
}

.ribbon-btn {
    width: 310px;
    height: 60px;
    margin-bottom: 16px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: stretch-to-fill;
    padding: 0;
    transition-property: scale, rotate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
}

.ribbon-btn:hover {
    scale: 1.06 1.06;
}

.ribbon-btn:active {
    scale: 0.95 0.95;
}

.btn-text-art {
    width: 80%;
    height: 70%;
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-back;
}

.ribbon-btn:hover .btn-text-art {
    scale: 1.02 1.02;
}

.btn-fallback-text {
    display: none;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}

.menu-footer {
    position: absolute;
    bottom: 16px;
    left: 24px;
    right: 24px;
    flex-direction: row;
    justify-content: space-between;
}

.footer-text {
    font-size: 15px;
    color: var(--color-text-muted);
}
