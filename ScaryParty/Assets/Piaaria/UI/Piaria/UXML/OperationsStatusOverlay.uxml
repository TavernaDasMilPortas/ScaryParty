<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Style src="../USS/NightIntermission.uss" />
    <Style src="../USS/OperationsStatus.uss" />
    <ui:VisualElement name="ops-overlay-root" class="ops-overlay-root">
        <ui:VisualElement class="ops-panel">
            <ui:Label text="CENTRAL DE SITUAÇÃO (TAB)" class="intermission-title" />
            <ui:VisualElement class="ops-grid">
                <ui:VisualElement class="ops-block">
                    <ui:Label text="NOITE &amp; META" class="ops-block-title" />
                    <ui:Label name="ops-night-goal" text="-" class="ops-block-body" />
                </ui:VisualElement>
                <ui:VisualElement class="ops-block">
                    <ui:Label text="REPUTAÇÃO &amp; OPERAÇÃO" class="ops-block-title" />
                    <ui:Label name="ops-reputation-orders" text="-" class="ops-block-body" />
                </ui:VisualElement>
                <ui:VisualElement class="ops-block">
                    <ui:Label text="EFEITOS &amp; UPGRADES" class="ops-block-title" />
                    <ui:Label name="ops-effects-upgrades" text="-" class="ops-block-body" />
                </ui:VisualElement>
                <ui:VisualElement class="ops-block">
                    <ui:Label text="EQUIPE ONLINE" class="ops-block-title" />
                    <ui:Label name="ops-online-team" text="-" class="ops-block-body" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
