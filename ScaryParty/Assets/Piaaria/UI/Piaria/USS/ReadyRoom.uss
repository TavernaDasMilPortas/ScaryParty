/* ========================================================
   P.I.A.R.I.A — Sala de Espera (Prancheta 4 + Editor Lado a Lado)
   ======================================================== */

.ready-room-bg {
    background-color: var(--color-bg-peach);
    padding: 16px 24px 18px 24px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

.ready-top-section {
    width: 100%;
    max-width: 1460px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.waiting-title-art {
    width: 300px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.room-code-banner {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 3px;
    border-radius: 10px;
    padding: 6px 14px;
}

.room-code-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    margin-right: 12px;
}

.btn-copy-code {
    font-size: 15px;
    padding: 6px 14px;
}

/* Scroll e Layout de Dois Blocos */
.ready-main-scroll {
    width: 100%;
    max-width: 1460px;
    flex-grow: 1;
}

.ready-main-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.ready-two-columns {
    width: 100%;
    max-height: 700px;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: center;
}

.ready-profile-wrapper {
    position: relative;
    width: 340px;
    min-width: 290px;
    max-width: 365px;
    flex-shrink: 0;
    margin-right: 14px;
}

.ready-profile-wrapper > .profile-editor-column {
    flex-grow: 1;
    height: 100%;
}

.ready-right-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 560px;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 4px;
    border-radius: 12px;
    padding: 14px 16px;
}

/* 4 Cartões */
.four-cards-row {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 10px;
}

.player-slot-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 145px;
    max-width: 255px;
    min-height: 300px;
    margin: 4px 6px;
    border-color: var(--color-border-brown);
    border-width: 3px;
    border-radius: 12px;
    padding: 12px;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-surface-card);
    -unity-background-scale-mode: stretch-to-fill;
}

.card-content-occupied {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
}

.player-name-ribbon {
    width: 100%;
    min-height: 44px;
    padding: 4px 8px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: stretch-to-fill;
}

.player-name-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-avatar-box {
    width: 135px;
    height: 145px;
    background-color: var(--color-paper-dark);
    border-color: var(--color-border-brown);
    border-width: 2.5px;
    border-radius: 10px;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.card-preview-rt {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.avatar-color-swatch {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--color-border-brown);
}

.avatar-fallback-icon {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}

.player-role-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}

.player-status-tag {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 7px 12px;
    border-radius: 8px;
    width: 94%;
    -unity-text-align: middle-center;
}

.status-ready {
    color: #1B5E20;
    background-color: #C8E6C9;
    border-color: #2E7D32;
    border-width: 2px;
}

.status-waiting {
    color: #E65100;
    background-color: #FFE0B2;
    border-color: #EF6C00;
    border-width: 2px;
}

/* Vaga Vazia */
.card-content-empty {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    border-width: 2px;
    border-color: var(--color-border-brown-light);
    border-radius: 10px;
    padding: 10px;
}

.empty-plus-icon {
    font-size: 38px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
}

.empty-slot-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.empty-subtext {
    font-size: 14px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}

/* Barra de Ações Inferior */
.ready-actions-bar {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 54px;
    margin-top: 6px;
}

.btn-action-ready,
.btn-action-start,
.btn-action-leave {
    flex-grow: 1;
    min-width: 180px;
    height: 48px;
    margin: 4px 6px;
}

/* Responsividade: Compacta (1280x720 / 1366x768) => empilha blocos e cards em 2x2 */
.layout-compact.ready-room-bg {
    padding: 10px 14px 12px 14px;
}

.layout-compact .ready-two-columns {
    flex-wrap: wrap;
    max-height: none;
    align-items: flex-start;
}

.layout-compact .four-cards-row {
    flex-wrap: wrap;
}

.layout-compact .ready-profile-wrapper {
    width: 100%;
    max-width: 520px;
    margin-right: 0;
    margin-bottom: 12px;
}

.layout-compact .ready-right-panel {
    width: 100%;
    min-width: 0;
}

.layout-compact .player-slot-card {
    flex-basis: 44%;
    max-width: 48%;
    min-height: 260px;
}

.layout-wide .ready-two-columns {
    max-width: 1460px;
    align-self: center;
}
