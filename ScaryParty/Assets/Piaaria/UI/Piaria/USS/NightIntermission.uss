/* P.I.A.R.I.A. Night Intermission 2.1 — Digital Cartoon UI Toolkit (Responsivo) */

.intermission-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(24, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.intermission-shell {
    width: 95%;
    max-width: 1220px;
    height: 90%;
    max-height: 820px;
    background-color: #f8d5c4;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 8px;
    border-left-width: 5px;
    border-color: #402318;
    border-radius: 22px;
    padding: 16px 20px;
    flex-direction: column;
}

.intermission-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.intermission-title {
    font-size: 28px;
    color: #402318;
    -unity-font-style: bold;
}

.intermission-subtitle {
    font-size: 16px;
    color: #6b3c2b;
    -unity-font-style: bold;
}

.intermission-budget-pill {
    background-color: #fffbf5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    padding: 6px 16px;
    flex-direction: row;
    align-items: center;
}

.intermission-budget-label {
    font-size: 20px;
    color: #2e7d32;
    -unity-font-style: bold;
}

.intermission-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.intermission-tab {
    flex-grow: 1;
    min-width: 140px;
    height: 42px;
    margin: 3px 4px;
    background-color: #ffebd5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 12px;
    color: #402318;
    font-size: 15px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
}

.intermission-tab-active {
    background-color: #ff741f;
    color: #fffbf5;
}

.intermission-tab-done {
    background-color: #d7f3dc;
    border-color: #2e7d32;
}

.intermission-page-scroll {
    flex-grow: 1;
    background-color: #ffebd5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 16px;
}

.intermission-page-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
}

.intermission-page-host {
    flex-grow: 1;
    padding: 16px;
}

.intermission-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    flex-shrink: 0;
}

.intermission-status-label {
    font-size: 16px;
    color: #402318;
    -unity-font-style: bold;
    flex-grow: 1;
    margin-right: 12px;
    white-space: normal;
}

.intermission-primary-btn {
    height: 46px;
    min-width: 170px;
    padding: 0 24px;
    background-color: #3ca34d;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    color: #fffbf5;
    font-size: 17px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 12px;
}

.summary-kpi-card {
    flex-grow: 1;
    flex-basis: 210px;
    min-width: 180px;
    min-height: 104px;
    background-color: #fffbf5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    padding: 12px 14px;
    margin: 5px;
    justify-content: center;
}

.summary-kpi-title {
    font-size: 14px;
    color: #6b3c2b;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.summary-kpi-value {
    font-size: 24px;
    color: #402318;
    -unity-font-style: bold;
}
