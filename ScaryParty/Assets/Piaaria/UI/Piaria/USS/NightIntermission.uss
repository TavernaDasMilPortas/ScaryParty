/* P.I.A.R.I.A. Night Intermission 2.1 — Digital Cartoon UI Toolkit */

.intermission-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(24, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.intermission-shell {
    width: 1180px;
    max-width: 94%;
    height: 760px;
    max-height: 92%;
    background-color: #f8d5c4;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 8px;
    border-left-width: 5px;
    border-color: #402318;
    border-radius: 22px;
    padding: 18px 22px;
    flex-direction: column;
}

.intermission-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.intermission-title {
    font-size: 30px;
    color: #402318;
    -unity-font-style: bold;
}

.intermission-subtitle {
    font-size: 16px;
    color: #6b3c2b;
    -unity-font-style: bold;
}

.intermission-budget-pill {
    background-color: #fffbf5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    padding: 6px 16px;
    flex-direction: row;
    align-items: center;
}

.intermission-budget-label {
    font-size: 20px;
    color: #2e7d32;
    -unity-font-style: bold;
}

.intermission-tabs {
    flex-direction: row;
    margin-bottom: 14px;
}

.intermission-tab {
    flex-grow: 1;
    height: 44px;
    margin-right: 8px;
    background-color: #ffebd5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 12px;
    color: #402318;
    font-size: 15px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
}

.intermission-tab-active {
    background-color: #ff741f;
    color: #fffbf5;
}

.intermission-tab-done {
    background-color: #d7f3dc;
    border-color: #2e7d32;
}

.intermission-page-host {
    flex-grow: 1;
    background-color: #ffebd5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 16px;
    padding: 18px;
    overflow: hidden;
}

.intermission-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
}

.intermission-status-label {
    font-size: 15px;
    color: #402318;
    -unity-font-style: bold;
}

.intermission-primary-btn {
    height: 46px;
    padding: 0 24px;
    background-color: #3ca34d;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    color: #fffbf5;
    font-size: 16px;
    -unity-font-style: bold;
}

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 14px;
}

.summary-kpi-card {
    width: 31%;
    min-height: 112px;
    background-color: #fffbf5;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 5px;
    border-left-width: 3px;
    border-color: #402318;
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 12px;
    justify-content: center;
}

.summary-kpi-title {
    font-size: 13px;
    color: #6b3c2b;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.summary-kpi-value {
    font-size: 26px;
    color: #402318;
    -unity-font-style: bold;
}
