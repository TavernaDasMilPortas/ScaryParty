.settings-card {
    width: 680px;
    max-height: 85%;
    flex-direction: column;
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-border-brown);
    padding-bottom: 12px;
    margin-bottom: 16px;
}

.close-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background-color: var(--color-btn-red);
    color: #FFFFFF;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settings-scroll {
    flex-grow: 1;
    padding-right: 12px;
}

.section-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--color-border-brown-light);
    margin-top: 14px;
    margin-bottom: 8px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.setting-label {
    font-size: 17px;
    color: var(--color-text-dark);
    flex-grow: 1;
}

.setting-slider {
    width: 240px;
    margin-right: 12px;
}

.setting-val-label {
    width: 50px;
    font-size: 16px;
    -unity-text-align: middle-right;
    color: var(--color-text-muted);
}

.setting-toggle {
    margin-right: 12px;
}

.setting-dropdown {
    width: 240px;
}

.setting-divider {
    height: 1px;
    background-color: var(--color-paper-dark);
    margin-top: 10px;
    margin-bottom: 10px;
}

.settings-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    gap: 16px;
}

.action-btn-half {
    flex-grow: 1;
}
