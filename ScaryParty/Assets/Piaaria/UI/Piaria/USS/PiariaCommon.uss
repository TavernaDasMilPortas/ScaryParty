/* ========================================================
   P.I.A.R.I.A — Identidade Visual e Tokens Comuns
   Paleta: Pêssego claro #f8d5c4, creme #ffebd5, tinta #402318,
           laranja #ff741f, papel #ffdec0 e artes ilustradas
   ======================================================== */

:root {
    --color-bg-peach: #f8d5c4;
    --color-cream: #ffebd5;
    --color-ink: #402318;
    --color-orange: #ff741f;
    --color-paper: #ffdec0;
    --color-paper-light: #ffebd5;
    --color-paper-dark: #f0caa8;
    --color-border-brown: #402318;
    --color-border-brown-light: #7a4630;
    --color-text-dark: #402318;
    --color-text-muted: #7a503e;
    --color-accent-yellow: #f8c045;
    --color-btn-orange: #ff741f;
    --color-btn-green: #3ca34d;
    --color-btn-blue: #2e79b9;
    --color-btn-red: #c83232;
    --color-btn-pink: #d94578;
    --color-surface-card: #fffbf5;
    --color-warning-bg: #fff4d6;
    --color-warning-border: #d97706;
    --color-danger-bg: #fee2e2;
    --color-success-bg: #dcfce7;
    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 14px;
    --space-lg: 22px;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    
    font-size: 18px;
    color: var(--color-text-dark);
    -unity-font: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
    -unity-font-definition: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
}

.fullscreen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.hud-pass-through {
    /* pickingMode definido como Ignore via UXML */
}

/* Tipografia Semântica */
.title-font {
    -unity-font: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/lost-tumbler/Lost Tumbler.otf");
    -unity-font-definition: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/lost-tumbler/Lost Tumbler.otf");
}

.body-font {
    -unity-font: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
    -unity-font-definition: url("project://database/Assets/Piaaria/Art/UI/Piaaria/uis giugiu/fonts/castle-chunk/CastleChunk-Regular.otf");
}

/* Painéis de Papel */
.paper-panel {
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 0;
    border-radius: 14px;
    padding: 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

.paper-panel-dark {
    background-color: var(--color-paper-dark);
    border-color: var(--color-border-brown);
    border-width: 0;
    border-radius: 14px;
    padding: 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Botões do Tema P.I.A.R.I.A */
.piaria-button {
    background-color: var(--color-btn-orange);
    border-color: var(--color-border-brown);
    border-width: 3px;
    border-radius: 12px;
    padding: 10px 20px;
    color: #FFFFFF;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.piaria-button-primary {
    background-color: var(--color-btn-orange);
}

.piaria-button-secondary {
    background-color: var(--color-btn-blue);
}

.piaria-button-success {
    background-color: var(--color-btn-green);
}

.piaria-button-danger {
    background-color: var(--color-btn-red);
}

.piaria-button:disabled {
    opacity: 0.5;
}

/* Campos de Texto e Inputs */
.piaria-input {
    background-color: #FFFDF8;
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 18px;
    color: var(--color-text-dark);
}

.piaria-input:focus {
    border-color: var(--color-accent-yellow);
    border-width: 3px;
}

/* Modais */
.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(40, 20, 10, 0.60);
    justify-content: center;
    align-items: center;
}

.modal-card {
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 4px;
    border-radius: 16px;
    padding: 26px;
    max-width: 820px;
}

.header-title-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}

/* Estados Compartilhados */
.is-disabled {
    opacity: 0.48;
}

.is-error {
    border-color: var(--color-btn-red);
    border-width: 3px;
}

.is-selected {
    border-color: var(--color-accent-yellow);
    border-width: 4px;
}

/* Editor de Perfil Compartilhado (Lobby & Sala de Espera) */
.profile-editor-column {
    flex-direction: column;
    background-color: var(--color-cream);
    border-color: var(--color-ink);
    border-width: 4px;
    border-radius: 8px;
    padding: 14px 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

.profile-editor-column .character-preview-card {
    width: 100%;
    min-height: 220px;
    flex-grow: 1;
    background-color: #fce8d5;
    border-color: var(--color-ink);
    border-width: 3.5px;
    border-radius: 6px;
    margin-top: 4px;
    margin-bottom: 10px;
    position: relative;
    overflow: hidden;
}

.profile-editor-column .preview-rt-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.profile-editor-column .swatches-paper-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
}

.profile-editor-column .swatch-paper-card {
    flex-grow: 1;
    flex-basis: 44px;
    max-width: 60px;
    height: 36px;
    margin: 2px;
    background-color: var(--color-surface-card);
    border-color: var(--color-ink);
    border-width: 2.5px;
    border-radius: 4px;
    padding: 3px;
    align-items: center;
    justify-content: center;
}

.profile-editor-column .swatch-paper-card.is-selected {
    border-color: var(--color-orange);
    border-width: 4px;
    background-color: #fff3c4;
}

.profile-editor-column .swatch-color-pill {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.color-pill-orange { background-color: #ff741f; }
.color-pill-green  { background-color: #7ec850; }
.color-pill-blue   { background-color: #3b82f6; }
.color-pill-pink   { background-color: #f472b6; }
.color-pill-red    { background-color: #ef4444; }

.col-ribbon-banner {
    height: 42px;
    width: 220px;
    max-width: 100%;
    align-self: center;
    justify-content: center;
    align-items: center;
    border-color: var(--color-ink);
    border-width: 3px;
    border-radius: 4px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.ribbon-yellow {
    background-color: #fcd34d;
}

.col-ribbon-title {
    color: var(--color-ink);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.field-caption {
    font-size: 15px;
    -unity-font-style: bold;
    color: #8c5a3c;
    margin-top: 2px;
    margin-bottom: 3px;
}

.paper-input-box {
    height: 38px;
    background-color: var(--color-surface-card);
    border-color: var(--color-ink);
    border-width: 2.5px;
    border-radius: 4px;
    color: var(--color-ink);
    font-size: 17px;
    -unity-font-style: bold;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 8px;
}

.paper-input-box > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--color-ink);
    font-size: 17px;
    -unity-font-style: bold;
    padding: 0;
}

.ribbon-action-btn {
    height: 44px;
    border-color: var(--color-ink);
    border-width: 3px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    -unity-background-scale-mode: stretch-to-fill;
}

.btn-orange { background-color: #ff741f; }
.btn-blue   { background-color: #2563eb; }
.btn-green  { background-color: #8cb836; }

.btn-action-label {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.layout-compact .profile-editor-column .character-preview-card {
    min-height: 170px;
}
