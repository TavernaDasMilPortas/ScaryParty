.scoreboard-overlay-root {
    background-color: rgba(20, 15, 10, 0.72);
    display: none;
    padding: 18px;
}

.scoreboard-card {
    width: 92%;
    max-width: 760px;
    max-height: 82%;
    flex-direction: column;
}

.mb-16 {
    margin-bottom: 14px;
}

.scoreboard-header-row {
    flex-direction: row;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-border-brown);
    padding-bottom: 8px;
    margin-bottom: 10px;
}

.scoreboard-header-cell {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-border-brown-light);
}

.col-name {
    flex-grow: 2;
    flex-basis: 0;
}

.col-pizzas {
    flex-grow: 1.2;
    flex-basis: 0;
    -unity-text-align: middle-center;
}

.col-money {
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-right;
}

.scoreboard-scroll {
    flex-grow: 1;
}

.scoreboard-item-row {
    flex-direction: row;
    align-items: center;
    background-color: #FFFDF8;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--color-border-brown-light);
    padding: 9px 14px;
    margin-bottom: 6px;
}

.scoreboard-item-row.scoreboard-local-row {
    border-color: var(--color-orange);
    border-width: 3px;
    background-color: #fff6e5;
}

.scoreboard-item-cell {
    font-size: 17px;
    -unity-font-style: bold;
}

.scoreboard-player-name {
    color: var(--color-text-dark);
}

.scoreboard-pizzas-cell {
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}

.scoreboard-money-cell {
    color: var(--color-btn-green);
    -unity-text-align: middle-right;
}

.scoreboard-hint {
    margin-top: 12px;
    font-size: 15px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}
