/* ========================================================
   P.I.A.R.I.A — Gameplay HUD (Pranchetas 5 & 6 + Responsivo)
   Sem barra permanente de binds na base; estilos em USS.
   ======================================================== */

.hud-pass-through {
    /* pickingMode Ignore gerenciado por UXML e Presenter */
}

/* Topo Esquerdo: Noite/Meta e Economia */
.hud-top-left {
    position: absolute;
    top: 22px;
    left: 24px;
    flex-direction: column;
    max-width: 440px;
}

.night-status-pill {
    background-color: var(--color-paper-light);
    border-color: var(--color-ink);
    border-width: 3px;
    border-radius: 10px;
    padding: 6px 14px;
    margin-bottom: 8px;
}

.night-status-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-ink);
    white-space: normal;
}

.hud-stats-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat-badge {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 3px;
    border-radius: 10px;
    padding: 6px 14px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.badge-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.badge-text {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

/* Topo Direito: Mochila */
.hud-top-right {
    position: absolute;
    top: 22px;
    right: 24px;
    align-items: flex-end;
}

.backpack-stack-box {
    width: 88px;
    height: 58px;
    position: relative;
    align-items: center;
    justify-content: center;
}

.backpack-art-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.backpack-badge-text {
    position: absolute;
    right: -4px;
    top: -4px;
    background-color: var(--color-btn-orange);
    border-color: var(--color-ink);
    border-width: 2px;
    color: #FFFFFF;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 10px;
    padding: 2px 7px;
}

.backpack-sub-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-ink);
    background-color: var(--color-paper-light);
    border-color: var(--color-ink);
    border-width: 2px;
    border-radius: 8px;
    padding: 3px 9px;
    margin-top: 6px;
}

.backpack-sub-label.bag-warning {
    background-color: var(--color-warning-bg);
    border-color: var(--color-warning-border);
    color: #92400e;
}

.backpack-sub-label.bag-critical {
    background-color: var(--color-danger-bg);
    border-color: var(--color-btn-red);
    color: #991b1b;
}

/* Topo Centro */
.hud-top-center {
    position: absolute;
    top: 22px;
    left: 50%;
    translate: -50% 0;
}

.orders-hint-card {
    background-color: var(--color-paper-dark);
    border-color: var(--color-border-brown);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px 18px;
}

.orders-hint-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

/* Centro: Mira e Prompt Contextual */
.combat-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    border-width: 2.5px;
    border-color: #FFFFFF;
    border-radius: 9px;
}

.combat-crosshair.crosshair-aiming {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-color: var(--color-accent-yellow);
}

.hud-center-anchor {
    position: absolute;
    left: 50%;
    top: 54%;
    translate: -50% -50%;
    align-items: center;
    max-width: 480px;
}

.interaction-prompt-box {
    background-color: rgba(48, 28, 18, 0.90);
    color: #FFFBF5;
    font-size: 18px;
    -unity-font-style: bold;
    padding: 9px 22px;
    border-radius: 18px;
    border-color: var(--color-accent-yellow);
    border-width: 2.5px;
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.progress-bar-box {
    align-items: center;
    display: none;
}

.progress-frame {
    width: 270px;
    height: 24px;
    background-color: rgba(40, 24, 16, 0.78);
    border-color: var(--color-border-brown);
    border-width: 2.5px;
    border-radius: 7px;
    overflow: hidden;
    margin-bottom: 5px;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-accent-yellow);
    -unity-background-scale-mode: stretch-to-fill;
}

.progress-text-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

/* Rodapé Esquerdo: Minimapa */
.hud-bottom-left {
    position: absolute;
    bottom: 22px;
    left: 24px;
    align-items: center;
}

.hud-bottom-left.minimap-fullscreen {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 12, 8, 0.45);
}

.minimap-paper-wrapper {
    width: 168px;
    height: 168px;
    border-radius: 84px;
    border-color: var(--color-border-brown);
    border-width: 4px;
    overflow: hidden;
    background-color: var(--color-paper-dark);
    margin-bottom: 5px;
}

.hud-bottom-left.minimap-fullscreen .minimap-paper-wrapper {
    width: 560px;
    height: 560px;
    border-radius: 14px;
}

.minimap-render-surface {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.minimap-hint-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-ink);
    background-color: var(--color-paper-light);
    border-color: var(--color-ink);
    border-width: 2px;
    border-radius: 6px;
    padding: 2px 8px;
}

/* Rodapé Direito: Vida, Arma/Bandoleira e Mãos */
.hud-bottom-right {
    position: absolute;
    bottom: 22px;
    right: 24px;
    flex-direction: column;
    align-items: flex-end;
}

.vital-compact-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-bottom: 8px;
}

.vital-pill {
    background-color: var(--color-paper-light);
    border-color: var(--color-ink);
    border-width: 2.5px;
    border-radius: 8px;
    padding: 5px 12px;
    margin-left: 8px;
    margin-bottom: 4px;
}

.vital-pill-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-ink);
}

.vital-pill-text.status-healthy {
    color: #166534;
}

.vital-pill-text.status-warning {
    color: #b45309;
}

.vital-pill-text.status-critical {
    color: #b91c1c;
}

.hands-row {
    flex-direction: row;
}

.hand-card {
    width: 170px;
    background-color: var(--color-paper-light);
    border-color: var(--color-border-brown);
    border-width: 2.5px;
    border-radius: 10px;
    padding: 8px 12px;
    margin-left: 12px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hand-card-active {
    border-color: var(--color-orange);
    border-width: 3.5px;
    background-color: #FFF9E6;
}

.hand-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.hand-digit-art {
    width: 16px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.hand-slot-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
}

.hand-content-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    white-space: normal;
}

/* Centro Inferior: apenas dica contextual temporária */
.hud-contextual-hint-anchor {
    position: absolute;
    bottom: 26px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    max-width: 520px;
}

.hud-contextual-hint-pill {
    background-color: var(--color-paper-light);
    border-color: var(--color-ink);
    border-width: 2.5px;
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-ink);
    -unity-text-align: middle-center;
}

/* Life & Spectator Banner (extraído para USS) */
.life-spectator-banner {
    position: absolute;
    left: 50%;
    bottom: 130px;
    translate: -50% 0;
    width: 520px;
    max-width: 90%;
    background-color: #fff3eb;
    border-color: var(--color-btn-red);
    border-width: 3px;
    border-radius: 14px;
    padding: 12px 18px;
    align-items: center;
}

.life-spectator-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-btn-red);
    -unity-text-align: middle-center;
}

.life-spectator-detail {
    font-size: 15px;
    color: var(--color-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 4px;
}

.life-progress-bg {
    width: 92%;
    height: 12px;
    background-color: var(--color-paper-dark);
    border-color: var(--color-ink);
    border-width: 2px;
    border-radius: 6px;
    overflow: hidden;
    margin-top: 8px;
}

.life-progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-btn-green);
}

.spectator-btn-row {
    flex-direction: row;
    margin-top: 10px;
}

.spectator-nav-btn {
    height: 34px;
    padding: 0 14px;
    margin: 0 5px;
    background-color: var(--color-btn-blue);
    border-color: var(--color-ink);
    border-width: 2px;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 15px;
    -unity-font-style: bold;
}

/* Responsividade HUD */
.layout-compact .hud-top-left {
    top: 14px;
    left: 14px;
    max-width: 340px;
}

.layout-compact .hud-top-right {
    top: 14px;
    right: 14px;
}

.layout-compact .hud-bottom-left {
    bottom: 14px;
    left: 14px;
}

.layout-compact .hud-bottom-left.minimap-fullscreen,
.layout-wide .hud-bottom-left.minimap-fullscreen {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.layout-compact .hud-bottom-right {
    bottom: 14px;
    right: 14px;
}

.layout-compact .hand-card {
    width: 142px;
    padding: 6px 10px;
    margin-left: 8px;
}

.layout-compact .minimap-paper-wrapper {
    width: 128px;
    height: 128px;
    border-radius: 64px;
}

.layout-compact .hud-bottom-left.minimap-fullscreen .minimap-paper-wrapper {
    width: 440px;
    height: 440px;
    border-radius: 14px;
}

.layout-wide .hud-top-left {
    left: 36px;
}

.layout-wide .hud-top-right {
    right: 36px;
}

.layout-wide .hud-bottom-left {
    left: 36px;
}

.layout-wide .hud-bottom-right {
    right: 36px;
}
