/* ========================================================
   P.I.A.R.I.A — Tela de Lobby (Responsiva, Prancheta 2)
   Layout: 3 Colunas proporcionais em normal/wide,
   com wrap e scroll vertical seguro em telas compactas.
   ======================================================== */

.lobby-bg {
    background-color: var(--color-bg-peach);
    padding: 16px 24px 18px 24px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    -unity-background-scale-mode: scale-and-crop;
}

/* --- TOPO --- */
.lobby-header-bar {
    width: 100%;
    max-width: 1320px;
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.btn-back-ribbon {
    width: 54px;
    height: 48px;
    background-color: #cb3428;
    border-color: #402318;
    border-width: 3.5px;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    padding: 0;
}

.btn-back-arrow {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
}

.lobby-title-logo {
    width: 260px;
    height: 58px;
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
}

.lobby-badge-container {
    width: 54px;
    align-items: flex-end;
}

/* --- SCROLL E COLUNAS --- */
.lobby-main-scroll {
    width: 100%;
    max-width: 1320px;
    flex-grow: 1;
}

.lobby-main-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.lobby-columns-row {
    width: 100%;
    max-height: 740px;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: stretch;
}

.lobby-column-wrapper {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 280px;
    max-width: 375px;
    margin-left: 8px;
    margin-right: 8px;
}

.col-profile-wrapper > .profile-editor-column {
    flex-grow: 1;
    height: 100%;
}

.lobby-column {
    background-color: #ffebd5;
    border-color: #402318;
    border-width: 4px;
    border-radius: 8px;
    padding: 14px 16px;
    margin-left: 8px;
    margin-right: 8px;
    flex-direction: column;
    -unity-background-scale-mode: stretch-to-fill;
}

.col-roomlist {
    flex-grow: 1.25;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 320px;
    max-width: 460px;
}

.col-connect {
    flex-grow: 1.05;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 300px;
    max-width: 400px;
    justify-content: space-between;
}

.section-sub-ribbon {
    width: 210px;
    height: 34px;
    margin-bottom: 6px;
}

.small-title {
    font-size: 16px;
}

/* Coluna 2: Lista de Salas */
.room-cards-scrollview {
    flex-grow: 1;
    min-height: 240px;
    margin-top: 4px;
    margin-bottom: 12px;
}

.empty-room-paper-box {
    align-items: center;
    justify-content: center;
    padding: 28px 14px;
}

.empty-pizza-art {
    width: 140px;
    height: 52px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.empty-main-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: #7a503e;
    margin-bottom: 2px;
}

.empty-sub-text {
    font-size: 15px;
    color: #a37d68;
}

.bottom-action-center {
    align-items: center;
    justify-content: center;
}

.btn-refresh-pill {
    width: 220px;
    max-width: 100%;
}

/* Cartões de Sala Gerados */
.room-entry {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #fffbf5;
    border-color: #402318;
    border-width: 3px;
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 10px;
}

.room-name-lbl {
    font-size: 18px;
    -unity-font-style: bold;
    color: #402318;
}

.room-details-lbl {
    font-size: 14px;
    color: #7a503e;
}

.btn-room-enter {
    background-color: #8cb836;
    border-color: #402318;
    border-width: 2.5px;
    border-radius: 4px;
    min-width: 96px;
    height: 38px;
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

/* Coluna 3: Conexões */
.connect-section-box {
    margin-bottom: 10px;
}

.last-box {
    margin-bottom: 0px;
}

.lan-buttons-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.btn-action-label-small {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.flex-1 { flex-grow: 1; }
.mr-6 { margin-right: 6px; }
.ml-6 { margin-left: 6px; }

/* Responsividade: Compacta (1280x720 / 1366x768) */
.layout-compact.lobby-bg {
    padding: 10px 14px 12px 14px;
}

.layout-compact .lobby-header-bar {
    height: 48px;
    margin-bottom: 6px;
}

.layout-compact .lobby-columns-row {
    flex-wrap: wrap;
    max-height: none;
    min-height: 0;
    align-items: flex-start;
}

.layout-compact .lobby-column-wrapper,
.layout-compact .lobby-column {
    flex-basis: 370px;
    max-width: 480px;
    margin-bottom: 12px;
    min-height: 480px;
}

/* Ultrawide (2560x1080) */
.layout-wide .lobby-columns-row {
    max-width: 1320px;
    align-self: center;
}
