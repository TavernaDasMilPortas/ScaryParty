/* Cards de Votação de Imprevistos & Oportunidades (UI Toolkit - Responsivo) */

.vote-page-root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.vote-page-header {
    margin-bottom: 10px;
}

.vote-cards-row {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
}

.modifier-card {
    flex-grow: 1;
    flex-basis: 260px;
    min-width: 240px;
    max-width: 380px;
    min-height: 230px;
    margin: 6px;
    background-color: #fffbf5;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 7px;
    border-left-width: 4px;
    border-color: #402318;
    border-radius: 18px;
    padding: 15px;
    flex-direction: column;
    justify-content: space-between;
}

.modifier-card-selected {
    border-color: #ff741f;
    background-color: #fff2e2;
}

.modifier-card-winner {
    border-color: #f8c045;
    background-color: #fff8dc;
}

.modifier-card-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.modifier-card-icon {
    font-size: 30px;
    color: #402318;
}

.modifier-card-tag {
    background-color: #f8d5c4;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 3px;
    border-left-width: 2px;
    border-color: #402318;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 13px;
    color: #402318;
    -unity-font-style: bold;
}

.modifier-card-title {
    font-size: 20px;
    color: #402318;
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.modifier-card-desc {
    font-size: 15px;
    color: #5b3828;
    white-space: normal;
    flex-grow: 1;
}

.modifier-card-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
}

.modifier-card-tickets {
    font-size: 15px;
    color: #402318;
    -unity-font-style: bold;
}

.modifier-card-btn {
    height: 38px;
    padding: 0 14px;
    background-color: #ff741f;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 4px;
    border-left-width: 2px;
    border-color: #402318;
    border-radius: 10px;
    color: #fffbf5;
    font-size: 15px;
    -unity-font-style: bold;
}

.modifier-card-btn-selected {
    background-color: #3ca34d;
}
