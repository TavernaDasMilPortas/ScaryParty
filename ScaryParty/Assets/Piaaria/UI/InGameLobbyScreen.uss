.fullscreen-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.6); /* Fundo semi-transparente cobrindo o jogo */
    align-items: center;
    justify-content: center;
}

.panel {
    background-color: #2b2b2b;
    border-radius: 18px;
    padding: 36px;
    width: 720px;
    border-width: 3px;
    border-color: #ff6600;
}

.title {
    font-size: 36px;
    -unity-font-style: bold;
    color: #ff8800;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.players-container {
    min-height: 220px;
    margin-bottom: 24px;
}

.player-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 14px 24px;
    margin-bottom: 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #ffffff;
    align-items: center;
}

.player-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: white;
}

.player-status {
    font-size: 20px;
    -unity-font-style: bold;
}

.buttons-container {
    flex-direction: column;
}

.ready-btn {
    background-color: #2e8b57;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 12px;
    height: 60px;
    margin-bottom: 12px;
}

.ready-btn:hover {
    background-color: #3cb371;
}

.start-btn {
    background-color: #ff6600;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 12px;
    height: 60px;
    margin-bottom: 12px;
}

.start-btn:hover {
    background-color: #ff8800;
}

.cancel-btn {
    background-color: #b22222;
    color: white;
    font-size: 19px;
    border-radius: 10px;
    height: 48px;
}

.cancel-btn:hover {
    background-color: #dc143c;
}
